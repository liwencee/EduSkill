# Build context for the API image (root Dockerfile). The image only needs
# package*.json, src/, tests/ and .eslintrc.js — keep everything else out so
# builds upload less and secrets can never be copied in.

# Dependencies and build output, at any depth
**/node_modules/
**/.next/
**/dist/
**/build/
**/coverage/
**/.nyc_output/

# The web app has its own Dockerfile and build context (web/)
web/

# Database, docs, scripts, tooling
supabase/
database/
docs/
scripts/
mobile/
.github/
.claude/
.vscode/
.idea/

# Logs
*.log
logs/

# Secrets
**/.env
**/.env.*
!.env.example

# Version control
.git/
.gitignore

# Docs (not needed at runtime)
README*.md
SECURITY.md
LICENSE
*.md

# Docker files themselves
Dockerfile
docker-compose*.yml
.dockerignore

# OS noise
**/.DS_Store
**/Thumbs.db
