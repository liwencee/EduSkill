NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

OPENAI_API_KEY=sk-...

PAYSTACK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_...

# ── Bunny Stream (lesson videos) ─────────────────────────────────────────────
# Bunny dashboard → Stream → your video library → API:
BUNNY_STREAM_LIBRARY_ID=123456
# (secret — server only)
BUNNY_STREAM_API_KEY=library-api-key
# Library → Security → "Embed view token authentication" key (turn it ON to protect paid lessons):
# (secret — server only)
BUNNY_STREAM_TOKEN_KEY=token-auth-key
# Library → API → "CDN Hostname" (used for video thumbnails):
NEXT_PUBLIC_BUNNY_STREAM_CDN_HOSTNAME=vz-xxxxxxxx-xxx.b-cdn.net

CLOUDFLARE_ACCOUNT_ID=...
CLOUDFLARE_STREAM_TOKEN=...

ACCREDIBLE_API_KEY=...
